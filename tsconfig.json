{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": false,
    "types": [
      "node",
      "vite/client"
    ],
    "noEmit": true,
    "paths": {
      "raptorq": [
        "./node_modules/raptorq/raptorq"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "scripts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
